{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS ELE Public Institution Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "country",
    "city",
    "location",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "type": {
      "enum": [
        "school",
        "language",
        "university",
        "association",
        "cervantes",
        "official"
      ]
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "postal_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "website": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        {
          "type": "null"
        }
      ]
    },
    "public_email": {
      "type": [
        "string",
        "null"
      ],
      "format": "email"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision",
        "status"
      ],
      "properties": {
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "precision": {
          "enum": [
            "unknown",
            "country",
            "region",
            "city",
            "address",
            "exact"
          ]
        },
        "status": {
          "enum": [
            "unreviewed",
            "needs_review",
            "verified"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institution",
        "spanish_program"
      ],
      "properties": {
        "institution": {
          "enum": [
            "unreviewed",
            "needs_review",
            "verified"
          ]
        },
        "spanish_program": {
          "enum": [
            "unreviewed",
            "needs_review",
            "verified"
          ]
        },
        "institution_source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "spanish_program_source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_updated": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}
